{
  "name": "@bonv/beacon-playwright",
  "version": "0.1.0",
  "description": "Capture and assert on Adobe Analytics hits (AppMeasurement + Web SDK) in Playwright tests.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "adobe-analytics",
    "playwright",
    "testing",
    "tag-qa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bonguynvan/beacon-parser.git",
    "directory": "packages/beacon-playwright"
  },
  "homepage": "https://github.com/bonguynvan/beacon-parser/tree/main/packages/beacon-playwright#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "dependencies": {
    "@bonv/beacon-parser": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
