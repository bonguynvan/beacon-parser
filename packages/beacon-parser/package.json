{
  "name": "@bonv/beacon-parser",
  "version": "0.1.0",
  "description": "Zero-dependency parser that decodes Adobe Analytics network hits (AppMeasurement + Web SDK) into normalized JSON.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "adobe-analytics",
    "appmeasurement",
    "web-sdk",
    "alloy",
    "tag-qa",
    "beacon-parser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bonguynvan/beacon-parser.git",
    "directory": "packages/beacon-parser"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
